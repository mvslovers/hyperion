# Guest: wait enabled; on each I/O interrupt log the unit status (500+),
# count CE/DE (404); on ATTN count it (400) and SIO a READ INQUIRY into
# 800+n*80 (408 = reads started, 40C = SIO cc 2/3). SIO cc 1 (CSW stored)
# is handled like an interrupt.
r 000=0000000000000200
r 048=00000300
r 078=0000000000000220
r 200=820002F0
r 220=58100414432000444221050041110001
r 230=50100414910C0044478002485810040441110001
r 244=50100404
r 248=918000444780029258100400411100015010040058100408
r 260=1831893000074133080050300300920A0300
r 272=41110001501004089C00000947800292
r 282=474002205810040C411100015010040C820002F0
r 2F0=FE02000000000000
r 300=0A00080020000080
restart
pause 1
/LINE1
/LINE2
/LINE3
pause 3
r 400.10
r 500.10
r 800.10
r 880.10
r 900.10
ipending
quit
